[Unit]
Description=Moonlit verified daily backup
After=moonlit.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/www/wwwroot/shion.wiki/current
EnvironmentFile=/etc/moonlit/site.env
EnvironmentFile=-/etc/moonlit/backup.env
ExecStart=/opt/moonlit-node/bin/node --disable-warning=ExperimentalWarning scripts/production-backup.mjs
UMask=0077
Nice=10
IOSchedulingClass=idle
