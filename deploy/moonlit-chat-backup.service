[Unit]
Description=Tsukiakari verified private chat backup
After=moonlit-chat.service

[Service]
Type=oneshot
User=moonlit
Group=moonlit
WorkingDirectory=/www/wwwroot/shion.wiki/chat-current
EnvironmentFile=/etc/moonlit/chat.env
Environment=BACKUP_DIR=/var/lib/moonlit-chat-backups
Environment=BACKUP_KEEP_COUNT=3
Environment=BACKUP_KEEP_DAYS=3
ExecStart=/opt/moonlit-node/bin/node --disable-warning=ExperimentalWarning scripts/production-backup.mjs
StateDirectory=moonlit-chat-backups
StateDirectoryMode=0700
UMask=0077
Nice=10
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
