# 本机 HTTP
HOST=127.0.0.1
PORT=4173
DATABASE_PATH=./data/moonlit.sqlite
SEED_DEMO=true

# 可选。Bot 生成直达链接时优先使用此值，只写 origin，例如 http://127.0.0.1:4173
PUBLIC_BASE_URL=
# 通过 HTTPS 反向代理运行时设为 true
COOKIE_SECURE=false

# 只供 admin:init 使用。留空时命令会在终端中请求密码，输入不回显。
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# 示例结构见 docs/bot-api.md。留空数组时 Bot API 不接受任何令牌。
# music:write / games:write 仅保存草稿；明确发布另授 content:sync。
# batches:read 查询本次清单；content-events:read 仅读取公开内容通知。
BOT_TOKENS=[]

# 访客日志和修改记录的保留天数、每类最大行数
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=50000

# IP 市级近似位置：仅服务端查询公开 IP；false 时不查询外部服务
IP_GEO_ENABLED=true
# 默认不信任任何转发头。使用反向代理后，填写实际代理的 IP/CIDR，逗号分隔。
# 示例（仅代理确实运行在本机时）：127.0.0.1/32,::1/128
TRUSTED_PROXIES=

# 月明かり：仅服务端读取模型凭据。兼容 OpenAI Chat Completions。
# 本地也可填写绝对路径，读取私有 JSON {"apiBase":"…","apiKey":"…","model":"…"}
CHAT_AI_CONFIG_FILE=
CHAT_AI_BASE_URL=
CHAT_AI_API_KEY=
CHAT_AI_MODEL=
CHAT_ASSISTANT_NAME=大肥鱼
CHAT_SYSTEM_PROMPT=

# 独立后端：website 禁用聊天路由；chat 通过下方地址联动网站。
# legacy 保留旧单库启动兼容性。独立部署时两个服务须指定不同 DATABASE_PATH。
SERVICE_MODE=legacy
WEBSITE_BASE_URL=
# 网站签发的只读事件令牌；网站自身仍按管理员会话校验管理写入。
WEBSITE_EVENT_TOKEN=

# AstrBot 4.29.1 的Tsukiakari兼容连接器。仅聊天后端读取，不能写入前端或安装包。
# JSON格式：{"baseUrl":"https://bot.example/bridge","chatToken":"…","adminToken":"…"}
ASTRBOT_CONFIG_FILE=
ASTRBOT_BASE_URL=
ASTRBOT_CHAT_TOKEN=
ASTRBOT_ADMIN_TOKEN=
# 桌面开发可用 TSUKIAKARI_ASTRBOT_FILE 覆盖私有配置路径。
# TSUKIAKARI_CHAT_SERVER_URL=https://chat.example 令桌面只连接独立远端聊天服务；默认仍本地。
